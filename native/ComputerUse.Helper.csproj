<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ComputerUse.Helper</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\UIAutomationClient\v4.0_4.0.0.0__31bf3856ad364e35\UIAutomationClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UIAutomationTypes">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\UIAutomationTypes\v4.0_4.0.0.0__31bf3856ad364e35\UIAutomationTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WindowsBase">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\WindowsBase\v4.0_4.0.0.0__31bf3856ad364e35\WindowsBase.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
<ItemGroup>
    <!-- The test project has its own csproj and must not be compiled into the helper. -->
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
